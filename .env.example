# ==============================================================================
# NERUMA INFRASTRUCTURE & COMMERCE - DEFINITIVE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMÍNIOS & TRAEFIK (EDGE LAYER)
# ------------------------------------------------------------------------------
DOMAIN=neruma.com.br
ACME_EMAIL=contato@neruma.com.br
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 (DATA LAYER - ISOLATED USERS)
# ------------------------------------------------------------------------------
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=generate_super_secret_pg_root_password_here

# Credenciais isoladas por aplicação (Privilégio Mínimo)
MEDUSA_DB_USER=medusa_user
MEDUSA_DB_PASSWORD=generate_medusa_db_password_here_123

PAYLOAD_DB_USER=payload_user
PAYLOAD_DB_PASSWORD=generate_payload_db_password_here_123

LISTMONK_DB_USER=listmonk_user
LISTMONK_DB_PASSWORD=generate_listmonk_db_password_here_123

MATOMO_DB_USER=matomo_user
MATOMO_DB_PASSWORD=generate_matomo_db_password_here_123

# ------------------------------------------------------------------------------
# 3. VALKEY 7.2 (CACHE / SESSIONS / QUEUES - BSD-3)
# ------------------------------------------------------------------------------
VALKEY_PASSWORD=generate_valkey_auth_password_here

# ------------------------------------------------------------------------------
# 4. SEAWEEDFS OBJECT STORAGE (APACHE 2.0 S3 GATEWAY)
# ------------------------------------------------------------------------------
S3_ACCESS_KEY_ID=neruma_seaweed_admin_key
S3_SECRET_ACCESS_KEY=generate_seaweed_secret_key_here_2026
S3_BUCKET_PRODUCTS=neruma-products
S3_BUCKET_CONTENT=neruma-content

# ------------------------------------------------------------------------------
# 5. TYPESENSE SEARCH ENGINE (C++ LEAN SEARCH)
# ------------------------------------------------------------------------------
TYPESENSE_API_KEY=generate_typesense_master_admin_key_here
TYPESENSE_PUBLIC_SEARCH_KEY=generate_typesense_readonly_search_key_here

# ------------------------------------------------------------------------------
# 6. MEDUSA V2 COMMERCE ENGINE
# ------------------------------------------------------------------------------
JWT_SECRET=generate_strong_medusa_jwt_secret_minimum_32_characters
COOKIE_SECRET=generate_strong_medusa_cookie_secret_minimum_32_chars

# Adaptadores de Pagamento Brasil
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx
ASAAS_API_KEY=$aact_xxxx
PAGARME_SECRET_KEY=ak_test_xxxx

# Adaptadores de Frete Brasil (Com dimensões e cubagem)
MELHOR_ENVIO_TOKEN=eyJ0eXAi...
MELHOR_ENVIO_SANDBOX=false
CORREIOS_USER=
CORREIOS_ACCESS_CODE=

# ------------------------------------------------------------------------------
# 7. PAYLOAD CMS 3.0
# ------------------------------------------------------------------------------
PAYLOAD_SECRET=generate_strong_payload_cms_secret_32_characters

# ------------------------------------------------------------------------------
# 8. NERUMA AI PRODUCT INTELLIGENCE LAYER (FASTAPI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
PINTEREST_ACCESS_TOKEN=pina_xxxx
INSTAGRAM_ACCESS_TOKEN=EAAG...

# ------------------------------------------------------------------------------
# 9. CLOUDFLARE R2 OFF-SITE BACKUPS (S3-COMPATIBLE)
# ------------------------------------------------------------------------------
R2_BACKUP_BUCKET=neruma-backups
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
