{
  "name": "neruma-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Neruma — E-commerce & Plataforma de Design Orgânico Monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:commerce": "turbo run build --filter=@neruma/commerce",
    "build:storefront": "turbo run build --filter=@neruma/storefront",
    "build:cms": "turbo run build --filter=@neruma/cms",
    "start": "echo 'Para iniciar no Railway, use o comando específico do serviço no Start Command (ex: pnpm run start:commerce)'",
    "start:commerce": "pnpm --filter @neruma/commerce start",
    "migrate:commerce": "pnpm --filter @neruma/commerce exec medusa db:migrate",
    "start:storefront": "pnpm --filter @neruma/storefront start",
    "start:cms": "pnpm --filter @neruma/cms start",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.7.0"
}
