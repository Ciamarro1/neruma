{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable pnpm && pnpm install --frozen-lockfile && pnpm run build:commerce"
  },
  "deploy": {
    "startCommand": "pnpm run start:commerce:prod",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
